# Copy to .env.local for personal overrides (gitignored — never committed).
#   cp .env.example .env.local
#
# Vue CLI loads: .env < .env.local < .env.[mode] < .env.[mode].local
# Only VUE_APP_-prefixed vars reach client code (process.env.VUE_APP_*),
# and they are BAKED INTO THE PUBLIC BUNDLE — no real secrets here.
# Build-time-only vars (no prefix) stay on the machine running the build.

# --- Client-visible (VUE_APP_ prefix, public) -------------------------

# Where the SPA sends lottery API requests. Default '/glo' relies on a
# same-origin reverse proxy. Point it elsewhere only if you host your own.
VUE_APP_LOTTERY_API_BASE=/glo

# --- Build/dev-time only (no prefix, never bundled) -------------------

# Override the dev-server proxy target for /glo (default: official GLO).
# GLO_PROXY_TARGET=https://www.glo.or.th

# Dev server port (Vue CLI standard).
# PORT=8080
