# Copy to db/.env and fill in (db/.env is gitignored — never committed).
# Blank on purpose: set your own values before `docker compose up`.

# SA password for the SQL Server container.
# Policy: min 8 chars with uppercase, lowercase, and digit/symbol.
MSSQL_SA_PASSWORD=

# Host port to expose SQL Server on (default 1433).
MSSQL_PORT=1433

# --- For the future API (apps/api) — keep blank until wiring it up -----
# ASP.NET Core reads this as ConnectionStrings:Default.
# Example value once filled:
#   Server=localhost,1433;Database=HtawPyi;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
ConnectionStrings__Default=
