# Committed defaults — safe, non-secret values only.
# Anything prefixed VUE_APP_ is compiled into the PUBLIC js bundle:
# never put real secrets in a VUE_APP_ variable.

# Base path the SPA uses for lottery API calls. '/glo' is proxied to
# https://www.glo.or.th by the dev server (vue.config.js) and by the
# Netlify/Vercel configs in production.
VUE_APP_LOTTERY_API_BASE=/glo
